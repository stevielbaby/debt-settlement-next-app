{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "patch-package || true",
    "docker:dev": "docker compose up || docker-compose up",
    "docker:build": "docker build -t debt-settlement-app .",
    "docker:prod": "docker compose -f docker-compose.prod.yml up || docker-compose -f docker-compose.prod.yml up",
    "docker:down": "docker compose down || docker-compose down",
    "docker:logs": "docker compose logs -f || docker-compose logs -f",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^6.19.1",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.454.0",
    "next": "16.1.0",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^6.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^20.1.0",
    "ws": "^8.18.3",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "jsdom": "^27.0.1",
    "lightningcss": "^1.30.2",
    "openapi-types": "^12.1.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "zod-to-json-schema": "^3.25.1"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.30.2",
    "lightningcss-darwin-x64": "^1.30.2",
    "lightningcss-linux-arm64-gnu": "^1.30.2",
    "lightningcss-linux-arm64-musl": "^1.30.2",
    "lightningcss-linux-x64-gnu": "^1.30.2",
    "lightningcss-linux-x64-musl": "^1.30.2"
  }
}
